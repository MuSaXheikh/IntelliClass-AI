# Root env used by docker-compose.yml only (copy to .env). Service-level examples live in
# backend/.env.example and frontend/.env.local.example.
POSTGRES_USER=intelliclass
POSTGRES_PASSWORD=          # required; generate: openssl rand -hex 24
POSTGRES_DB=intelliclass
POSTGRES_PORT=5433          # host port; 5433 avoids a host PostgreSQL on 5432
API_PORT=8000               # host port for the API container
REDIS_PORT=6380             # only with --profile redis
STORAGE_BACKEND=local       # or supabase, with SUPABASE_URL reachable from the container
SUPABASE_URL=               # e.g. http://host.docker.internal:54321 for the Supabase CLI stack
