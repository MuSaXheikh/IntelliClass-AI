# Leave API/WS empty to derive them from the page's own host: http(s)://<host>:8000/api/v1 and
# ws(s)://<host>:8000/ws. That is what makes the phone-over-LAN demo work. Set them only when the
# backend lives on another host or port, e.g. NEXT_PUBLIC_API_URL=https://api.example.edu/api/v1
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_LIVEKIT_URL=
