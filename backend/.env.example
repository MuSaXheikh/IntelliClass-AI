# Copy to .env (never commit .env)
ENVIRONMENT=local
DATABASE_URL=sqlite:///./intelliclass.db
AUTO_CREATE_TABLES=true
REDIS_URL=
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=120
ALLOWED_ORIGINS=http://localhost:3000
STORAGE_DIR=./storage

# LiveKit (leave empty to run without video; join returns livekit_token=null)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Vision / alert thresholds (placeholders: tune on the validation set, AI-04)
VISION_FPS=8
EAR_CLOSED_THRESHOLD=0.20
PERCLOS_SLEEPY_THRESHOLD=0.60
LANDMARK_CONF_MIN=0.50
HEAD_YAW_LIMIT_DEG=30
HEAD_PITCH_LIMIT_DEG=25
DROWSY_MIN_SECONDS=5
LOOKAWAY_MIN_SECONDS=20
NOFACE_MIN_SECONDS=10
CAMERA_OFF_MIN_SECONDS=10
SCREEN_GRACE_SECONDS=20
CONNECTION_TIMEOUT_SECONDS=8
STATUS_HOLD_SECONDS=3
ALERT_CONFIDENCE_THRESHOLD=0.60
ALERT_COOLDOWN_SECONDS=60
ALERT_GROUP_WINDOW_SECONDS=600
NUDGE_RATE_LIMIT=3
NUDGE_RATE_WINDOW_SECONDS=600
