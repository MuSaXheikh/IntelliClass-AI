# Copy to .env (never commit .env)
ENVIRONMENT=local
# Local Supabase: run `supabase start` in backend/ and copy DB_URL from `supabase status`,
# adding the +psycopg driver. Any PostgreSQL works; sqlite:///./intelliclass.db for a quick trial.
DATABASE_URL=postgresql+psycopg://postgres:<db-password>@127.0.0.1:54322/postgres
# Tables are created by Alembic (uv run alembic upgrade head); keep this false
AUTO_CREATE_TABLES=false
REDIS_URL=
# Required, at least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=http://localhost:3000
# Slide images: "local" keeps PNGs under STORAGE_DIR and works out of the box; "supabase" uploads
# them to a private bucket of the Supabase stack (then set SUPABASE_SERVICE_KEY from `supabase status`)
STORAGE_BACKEND=local
STORAGE_DIR=./storage
SUPABASE_URL=http://127.0.0.1:54321
# SERVICE_ROLE_KEY from `supabase status` (server-side only, never the anon key, never committed)
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=slides
# PowerPoint/ODP uploads are converted with LibreOffice (apt install libreoffice-impress)
SOFFICE_PATH=soffice
SLIDE_CONVERT_TIMEOUT_SECONDS=120

# LiveKit (leave empty to run without video; join returns livekit_token=null)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Vision / alert thresholds (placeholders: tune on the validation set, AI-04)
VISION_FPS=8
EAR_CLOSED_THRESHOLD=0.20
PERCLOS_SLEEPY_THRESHOLD=0.60
LANDMARK_CONF_MIN=0.50
HEAD_YAW_LIMIT_DEG=30
HEAD_PITCH_LIMIT_DEG=25
DROWSY_MIN_SECONDS=5
LOOKAWAY_MIN_SECONDS=12
NOFACE_MIN_SECONDS=8
CAMERA_OFF_MIN_SECONDS=8
SCREEN_GRACE_SECONDS=12
CONNECTION_TIMEOUT_SECONDS=8
STATUS_HOLD_SECONDS=1
SESSION_IDLE_MINUTES=45
ATTENDED_MIN_SECONDS=60
FEATURE_SMOOTHING_PACKETS=1
VISION_DEBUG_LOG=false
ALERT_CONFIDENCE_THRESHOLD=0.60
ALERT_COOLDOWN_SECONDS=60
ALERT_GROUP_WINDOW_SECONDS=600
NUDGE_RATE_LIMIT=3
NUDGE_RATE_WINDOW_SECONDS=600
